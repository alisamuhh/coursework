<Window x:Class="coursework.MatchingPropertiesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список подходящих предложений"
        Width="950"
        Height="720"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,12">

            <DockPanel>
                <TextBlock Text="Документ для клиента"
                           FontSize="19"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">

                    <Button Content="Распечатать"
                            Click="Print_Click"
                            Background="#059669"
                            Foreground="White"
                            Padding="16,8"
                            Margin="5"/>

                    <Button Content="Закрыть"
                            Click="Close_Click"
                            Background="#64748B"
                            Foreground="White"
                            Padding="16,8"
                            Margin="5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15">

            <FlowDocumentScrollViewer
                                      x:Name="DocumentViewer"
                                      IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"/>

        </Border>
    </Grid>
</Window>
