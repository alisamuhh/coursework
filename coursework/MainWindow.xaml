<Window x:Class="coursework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агентство недвижимости"
        Width="1300"
        Height="850"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#243247">
            <StackPanel Margin="25,15">
                <TextBlock Text="АГЕНТСТВО НЕДВИЖИМОСТИ"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="Информационная система риэлтерской фирмы"
                           Foreground="#CBD5E1"
                           Margin="0,5,0,0"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Margin="15">

            <!-- ====================================== -->
            <!-- КЛИЕНТЫ -->
            <!-- ====================================== -->


            <TabItem Header="Клиенты">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0"
                               Margin="0,0,0,12">

                        <Button Content="Новый клиент"
                                Background="#2563EB"
                                Click="NewClient_Click"/>

                        <Button Content="Редактировать клиента"
                                Click="EditClient_Click"/>

                        <Button Content="Удалить клиента"
                                Background="#DC2626"
                                Click="DeleteClient_Click"/>

                        <Button Content="Сформировать квитанцию"
                                Background="#059669"
                                Click="CreateReceipt_Click"/>
                    </WrapPanel>

                    <GroupBox Grid.Row="1"
                              Header="Зарегистрированные клиенты">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                                <TextBlock Text="Поиск клиента:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                                <TextBox x:Name="ClientSearchTextBox"
                             Width="300"
                             TextChanged="ClientSearch_TextChanged"/>

                                <TextBlock x:Name="ClientCountTextBlock"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                            </StackPanel>

                            <DataGrid x:Name="ClientsGrid"
                          Grid.Row="1"
                          SelectionChanged="ClientsGrid_SelectionChanged">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО / Организация"
                                            Binding="{Binding DisplayName}"
                                            Width="2*"/>

                                    <DataGridTextColumn Header="Телефон"
                                            Binding="{Binding Phone}"
                                            Width="*"/>

                                    <DataGridTextColumn Header="Эл. почта"
                                            Binding="{Binding Email}"
                                            Width="*"/>

                                    <DataGridTextColumn Header="Тип клиента"
                                            Binding="{Binding ClientType}"
                                            Width="*"/>

                                    <DataGridTextColumn Header="Адрес"
                                            Binding="{Binding Address}"
                                            Width="2*"/>

                                    <DataGridTextColumn Header="Рег. номер"
                                            Binding="{Binding RegistrationNumber}"
                                            Width="*"/>

                                    <DataGridTextColumn Header="Дата регистрации"
                                            Binding="{Binding RegistrationDate,
                                            StringFormat=dd.MM.yyyy}"
                                            Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>


            <!-- ====================================== -->
            <!-- НЕДВИЖИМОСТЬ -->
            <!-- ====================================== -->

            <TabItem Header="Недвижимость">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="380"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="PropertyScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>


                            <GroupBox Header="Основные сведения об объекте">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Владелец"/>
                                        <ComboBox x:Name="OwnerComboBox"
                                                    DisplayMemberPath="FullName"/>

                                        <TextBlock Text="Категория недвижимости"/>
                                        <ComboBox x:Name="CategoryComboBox"
                                                    SelectedIndex="0"
                                                    SelectionChanged="CategoryComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Квартира"/>
                                            <ComboBoxItem Content="Дом"/>
                                            <ComboBoxItem Content="Комната"/>
                                        </ComboBox>

                                        <TextBlock Text="Тип операции"/>
                                        <ComboBox x:Name="OperationComboBox"
                                                    SelectedIndex="0">
                                            <ComboBoxItem Content="Продажа"/>
                                            <ComboBoxItem Content="Аренда"/>
                                        </ComboBox>

                                        <TextBlock Text="Район"/>
                                        <TextBox x:Name="DistrictTextBox"/>

                                        <TextBlock Text="Адрес объекта"/>
                                        <TextBox x:Name="PropertyAddressTextBox"/>

                                        <TextBlock x:Name="RoomsLabel"
                                                     Text="Количество комнат"/>
                                        <TextBox x:Name="RoomsTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <StackPanel x:Name="FloorPanel">
                                            <TextBlock Text="Этаж"/>
                                            <TextBox x:Name="FloorTextBox"/>
                                        </StackPanel>

                                        <TextBlock Text="Общая площадь, м²"/>
                                        <TextBox x:Name="AreaTextBox"/>

                                        <TextBlock Text="Жилая площадь, м²"/>
                                        <TextBox x:Name="LivingAreaTextBox"/>

                                        <TextBlock Text="Площадь кухни, м²"/>
                                        <TextBox x:Name="KitchenAreaTextBox"/>

                                        <TextBlock Text="Цена, руб. (аренда — в месяц)"/>
                                        <TextBox x:Name="PriceTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>


                            <GroupBox Header="Характеристики здания">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Этажность здания"/>
                                        <TextBox x:Name="BuildingFloorsTextBox"/>

                                        <TextBlock Text="Материал здания"/>
                                        <ComboBox x:Name="BuildingMaterialComboBox"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Кирпич"/>
                                            <ComboBoxItem Content="Панель"/>
                                            <ComboBoxItem Content="Монолит"/>
                                            <ComboBoxItem Content="Дерево"/>
                                            <ComboBoxItem Content="Другое"/>
                                        </ComboBox>

                                        <TextBlock Text="Год постройки"/>
                                        <TextBox x:Name="ConstructionYearTextBox"/>

                                        <TextBlock Text="Год капитального ремонта"/>
                                        <TextBox x:Name="LastRepairYearTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="BalconyCheckBox"
                                                  Content="Балкон"
                                                  Margin="0,8"/>

                                        <CheckBox x:Name="LoggiaCheckBox"
                                                  Content="Лоджия"
                                                  Margin="0,8"/>

                                        <CheckBox x:Name="ElevatorCheckBox"
                                                  Content="Лифт"
                                                  Margin="0,8"/>

                                        <CheckBox x:Name="GarbageChuteCheckBox"
                                                  Content="Мусоропровод"
                                                  Margin="0,8"/>

                                        <CheckBox x:Name="TelephoneCableCheckBox"
                                                  Content="Телефонный кабель"
                                                  Margin="0,8"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>


                            <GroupBox Header="Условия сделки">
                                <StackPanel>

                                    <TextBlock Text="Описание объекта"/>

                                    <TextBox x:Name="PropertyDescriptionTextBox"
                                               Height="75"
                                               AcceptsReturn="True"
                                               TextWrapping="Wrap"
                                               VerticalContentAlignment="Top"
                                               VerticalScrollBarVisibility="Auto"/>

                                    <TextBlock Text="Дополнительные условия"/>

                                    <TextBox x:Name="PropertyConditionsTextBox"
                                               Height="70"
                                               AcceptsReturn="True"
                                               TextWrapping="Wrap"
                                               VerticalContentAlignment="Top"/>

                                    <Button Content="Новая недвижимость"
                                            HorizontalAlignment="Left"
                                            Background="#2563EB"
                                            Click="NewProperty_Click"/>

                                    <Button Content="Добавить недвижимость"
                                            HorizontalAlignment="Left"
                                            Click="AddProperty_Click"/>

                                </StackPanel>
                            </GroupBox>


                        </StackPanel>
                    </ScrollViewer>

                    <GroupBox Grid.Row="1"
                              Header="Объекты недвижимости"
                              Margin="0,10,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0"
                                       Margin="0,0,0,8">

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Поиск по адресу или району"/>
                                    <TextBox x:Name="PropertySearchTextBox"
                                             Width="240"
                                             TextChanged="PropertyFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Категория"/>
                                    <ComboBox x:Name="PropertyCategoryFilter"
                                              Width="160"
                                              SelectedIndex="0"
                                              SelectionChanged="PropertyFilter_Changed">
                                        <ComboBoxItem Content="Все категории"/>
                                        <ComboBoxItem Content="Квартира"/>
                                        <ComboBoxItem Content="Дом"/>
                                        <ComboBoxItem Content="Комната"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Тип операции"/>
                                    <ComboBox x:Name="PropertyOperationFilter"
                                              Width="160"
                                              SelectedIndex="0"
                                              SelectionChanged="PropertyFilter_Changed">
                                        <ComboBoxItem Content="Все операции"/>
                                        <ComboBoxItem Content="Продажа"/>
                                        <ComboBoxItem Content="Аренда"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Grid.Row="1"
                                       Margin="0,0,0,8">

                                <Button Content="Сохранить изменения"
                                        Click="UpdateProperty_Click"/>

                                <Button Content="Удалить объект"
                                        Background="#DC2626"
                                        Click="DeleteProperty_Click"/>

                                <Button Content="Найти подходящие заявки"
                                        Background="#059669"
                                        Click="FindRequestsForSelectedProperty_Click"/>



                                <Button Content="Очистить форму"
                                        Background="#64748B"
                                        Click="ClearProperty_Click"/>

                                <TextBlock x:Name="PropertyCountTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"/>
                            </WrapPanel>

                            <DataGrid x:Name="PropertiesGrid"
                                      Grid.Row="2"
                                      SelectionChanged="PropertiesGrid_SelectionChanged">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Категория"
                                        Binding="{Binding Category}"
                                        Width="110"/>


                                    <DataGridTextColumn Header="Описание объекта"
                                                        Binding="{Binding Description, Mode=OneWay}"
                                                        Width="290"/>


                                    <DataGridTextColumn Header="Операция"
                                        Binding="{Binding OperationType}"
                                        Width="100"/>

                                    <DataGridTextColumn Header="Район"
                                        Binding="{Binding District}"
                                        Width="130"/>

                                    <DataGridTextColumn Header="Адрес"
                                        Binding="{Binding Address}"
                                        Width="220"/>

                                    <DataGridTextColumn Header="Владелец"
                                        Binding="{Binding OwnerName, Mode=OneWay}"
                                        Width="190"/>

                                    <DataGridTextColumn Header="Комнат"
                                        Binding="{Binding Rooms}"
                                        Width="70"/>

                                    <DataGridTextColumn Header="Этаж"
                                        Binding="{Binding Floor}"
                                        Width="65"/>

                                    <DataGridTextColumn Header="Площадь, м²"
                                        Binding="{Binding TotalArea}"
                                        Width="115"/>

                                    <DataGridTextColumn Header="Цена, руб."
                                        Binding="{Binding Price, StringFormat={}{0:N0}}"
                                        Width="140"/>

                                    <DataGridTextColumn Header="Материал дома"
                                        Binding="{Binding BuildingMaterial}"
                                        Width="125"/>

                                    <DataGridCheckBoxColumn Header="Доступен"
                                        Binding="{Binding IsAvailable, Mode=OneWay}"
                                        Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ====================================== -->
            <!-- ЗАЯВКИ И ПОДБОР -->
            <!-- ====================================== -->


            <TabItem Header="Заявки и подбор">
                <TabControl Margin="12">

                    <!-- ПОДРАЗДЕЛ 1: ОФОРМЛЕНИЕ ЗАЯВКИ -->
                    <TabItem Header="Оформление заявки">
                        <ScrollViewer x:Name="RequestScrollViewer" 
                            Margin="10"
                          VerticalScrollBarVisibility="Auto">
                            <GroupBox Header="Параметры заявки">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Клиент"/>
                                        <ComboBox x:Name="RequestClientComboBox"
                                      DisplayMemberPath="FullName"/>

                                        <TextBlock Text="Тип заявки"/>
                                        <ComboBox x:Name="RequestOperationComboBox"
                                      SelectedIndex="0">
                                            <ComboBoxItem Content="Покупка"/>
                                            <ComboBoxItem Content="Аренда"/>
                                        </ComboBox>

                                        <TextBlock Text="Категория недвижимости"/>
                                        <ComboBox x:Name="RequestCategoryComboBox"
                                      SelectedIndex="0">
                                            <ComboBoxItem Content="Квартира"/>
                                            <ComboBoxItem Content="Дом"/>
                                            <ComboBoxItem Content="Комната"/>
                                        </ComboBox>

                                        <TextBlock Text="Предпочтительный район"/>
                                        <TextBox x:Name="RequestDistrictTextBox"/>

                                        <TextBlock Text="Предпочитаемый этаж (0 — любой)"/>
                                        <TextBox x:Name="RequestFloorTextBox"
                                     Text="0"/>

                                        <TextBlock Text="Этажность дома (0 — любая)"/>
                                        <TextBox x:Name="RequestBuildingFloorsTextBox"
                                     Text="0"/>

                                        <TextBlock Text="Материал здания"/>
                                        <ComboBox x:Name="RequestBuildingMaterialComboBox"
                                      SelectedIndex="0">
                                            <ComboBoxItem Content="Любой"/>
                                            <ComboBoxItem Content="Кирпич"/>
                                            <ComboBoxItem Content="Панель"/>
                                            <ComboBoxItem Content="Монолит"/>
                                            <ComboBoxItem Content="Дерево"/>
                                            <ComboBoxItem Content="Другое"/>
                                        </ComboBox>

                                        <TextBlock Text="Минимальный год постройки (0 — любой)"/>
                                        <TextBox x:Name="RequestConstructionYearTextBox"
                                     Text="0"/>

                                        <TextBlock Text="Минимальный год капитального ремонта (0 — любой)"/>
                                        <TextBox x:Name="RequestRepairYearTextBox"
                                     Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Минимальное количество комнат"/>
                                        <TextBox x:Name="RequestRoomsTextBox"/>

                                        <TextBlock Text="Минимальная общая площадь, м²"/>
                                        <TextBox x:Name="RequestAreaTextBox"/>

                                        <TextBlock Text="Минимальная жилая площадь, м² (0 — любая)"/>
                                        <TextBox x:Name="RequestLivingAreaTextBox"
                                     Text="0"/>

                                        <TextBlock Text="Минимальная площадь кухни, м² (0 — любая)"/>
                                        <TextBox x:Name="RequestKitchenAreaTextBox"
                                     Text="0"/>

                                        <TextBlock Text="Максимальная цена, руб."/>
                                        <TextBox x:Name="RequestPriceTextBox"/>

                                        <TextBlock Text="Дополнительные пожелания"/>
                                        <TextBox x:Name="RequestConditionsTextBox"/>

                                        <TextBlock Text="Требования к удобствам"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8"/>

                                        <CheckBox x:Name="RequestBalconyCheckBox"
                                      Content="Балкон"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="0,5"/>

                                        <CheckBox x:Name="RequestLoggiaCheckBox"
                                      Content="Лоджия"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="0,5"/>

                                        <CheckBox x:Name="RequestElevatorCheckBox"
                                      Content="Лифт"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="0,5"/>

                                        <CheckBox x:Name="RequestGarbageChuteCheckBox"
                                      Content="Мусоропровод"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="0,5"/>

                                        <CheckBox x:Name="RequestTelephoneCableCheckBox"
                                      Content="Телефонный кабель"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="0,5"/>

                                        <TextBlock Text="Галочка — обязательно есть; пустой квадрат — обязательно нет; промежуточное состояние — неважно."
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="0,5,0,12"/>

                                        <CheckBox x:Name="SpecialRequestCheckBox"
                                      Content="Специальный заказ"
                                      Margin="0,8"/>

                                        <Button Content="Зарегистрировать заявку"
                                    Click="FindProperties_Click"/>

                                        <Button Content="Сохранить изменения"
                                    Click="UpdateRequest_Click"/>

                                        <Button Content="Удалить выбранную заявку"
                                    Background="#DC2626"
                                    Click="DeleteRequest_Click"/>

                                        <Button Content="Очистить форму"
                                    Background="#64748B"
                                    Click="ClearRequest_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ПОДРАЗДЕЛ 2: ПОДБОР НЕДВИЖИМОСТИ -->
                    <TabItem Header="Подбор недвижимости">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" MinHeight="190"/>
                                <RowDefinition Height="3*" MinHeight="230"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0"
                          Header="Зарегистрированные заявки">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <WrapPanel Grid.Row="0"
                                   Margin="0,0,0,8">
                                        <Button Content="Найти недвижимость"
                                    Click="SearchExistingRequest_Click"/>

                                        <Button Content="Список предложений для печати"
                                    Background="#059669"
                                    Click="PrintMatchingProperties_Click"/>
                                    </WrapPanel>

                                    <DataGrid x:Name="RequestsGrid"
                                              Grid.Row="1"
                                              SelectionChanged="RequestsGrid_SelectionChanged">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpecial}"
                                                                 Value="True">
                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSpecial}"
                                                                       Value="True"/>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                                                       Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background"
                                                                Value="#DBEAFE"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Заказчик"
                                                    Binding="{Binding ClientName}"
                                                    Width="200"/>
                                            <DataGridTextColumn Header="Тип заявки"
                                                    Binding="{Binding OperationType}"
                                                    Width="110"/>

                                            <DataGridTextColumn Header="Категория"
                                                    Binding="{Binding Category}"
                                                    Width="110"/>

                                            <DataGridTextColumn Header="Район"
                                                    Binding="{Binding District}"
                                                    Width="140"/>

                                            <DataGridTextColumn Header="Мин. комнат"
                                                    Binding="{Binding MinimumRooms}"
                                                    Width="100"/>

                                            <DataGridTextColumn Header="Мин. площадь"
                                                    Binding="{Binding MinimumArea}"
                                                    Width="110"/>

                                            <DataGridTextColumn Header="Макс. цена"
                                                    Binding="{Binding MaximumPrice, StringFormat={}{0:N0}}"
                                                    Width="130"/>

                                            <DataGridCheckBoxColumn Header="Спецзаказ"
                                                        Binding="{Binding IsSpecial, Mode=OneWay}"
                                                        Width="90"/>

                                            <DataGridTextColumn Header="Дата заявки"
                                                    Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                                    Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="1"
                          Header="Подходящие предложения">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="ResultsGrid"
                                  Grid.Row="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Категория"
                                                    Binding="{Binding Category}"
                                                    Width="120"/>

                                            <DataGridTextColumn Header="Район"
                                                    Binding="{Binding District}"
                                                    Width="140"/>

                                            <DataGridTextColumn Header="Адрес"
                                                    Binding="{Binding Address}"
                                                    Width="*"/>

                                            <DataGridTextColumn Header="Комнат"
                                                    Binding="{Binding Rooms}"
                                                    Width="80"/>

                                            <DataGridTextColumn Header="Площадь, м²"
                                                    Binding="{Binding TotalArea}"
                                                    Width="120"/>

                                            <DataGridTextColumn Header="Цена, руб."
                                                    Binding="{Binding Price, StringFormat={}{0:N0}}"
                                                    Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1"
                                    Margin="0,8,0,0">

                                        <TextBlock Text="Комментарий или причина отказа"/>

                                        <TextBox x:Name="OfferCommentTextBox"
                                     Height="32"
                                     Margin="4,0,4,4"/>

                                        <WrapPanel>
                                            <Button Content="Принять предложение"
                                        Background="#059669"
                                        Click="AcceptOffer_Click"/>

                                            <Button Content="Отказаться"
                                        Background="#DC2626"
                                        Click="RejectOffer_Click"/>

                                            <Button Content="Перейти к оформлению сделки"
                                        Background="#2563EB"
                                        Click="GoToDeal_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>
            <!-- Вкладка оформления сделок -->

            <TabItem Header="Сделки">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Оформление сделки -->
                    <GroupBox Header="Оформление сделки"
                  Grid.Row="0"
                  Margin="0,0,0,15"
                  Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Покупатель или арендатор -->
                            <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,12">
                                <TextBlock Text="Покупатель / арендатор"
                               Margin="0,0,0,5"/>
                                <ComboBox x:Name="DealClientComboBox"
                              DisplayMemberPath="DisplayName"
                              Height="35"/>
                            </StackPanel>

                            <!-- Недвижимость -->
                            <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,12">
                                <TextBlock Text="Объект недвижимости"
                               Margin="0,0,0,5"/>
                                <ComboBox x:Name="DealPropertyComboBox"
                                          DisplayMemberPath="Address"
                                          Height="35"
                                          SelectionChanged="DealPropertyComboBox_SelectionChanged"/>
                            </StackPanel>

                            <!-- Продавец -->
                            <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,12">
                                <TextBlock Text="Продавец / собственник"
                               Margin="0,0,0,5"/>
                                <TextBox x:Name="DealSellerTextBox"
                             Height="35"
                             IsReadOnly="True"
                             Text="Выберите недвижимость"/>
                            </StackPanel>

                            <!-- Сумма -->
                            <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,0,12">
                                <TextBlock Text="Сумма сделки, руб."
                               Margin="0,0,0,5"/>
                                <TextBox x:Name="DealAmountTextBox"
                             Height="35"
                             TextChanged="DealAmountTextBox_TextChanged"/>
                            </StackPanel>

                            <!-- Комиссия -->
                            <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,0,0,12">
                                <TextBlock Text="Комиссия агентства (2%)"
                               Margin="0,0,0,5"/>
                                <TextBlock x:Name="DealCommissionTextBlock"
                               Text="0 руб."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#2563EB"/>
                            </StackPanel>

                            <!-- Кнопка -->
                            <Button Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Content="Оформить сделку"
                        Height="42"
                        Margin="0,8,0,0"
                        Click="AddDeal_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- История сделок -->
                    <GroupBox Header="История сделок"
                  Grid.Row="1"
                  Padding="15">
                        <DockPanel>
                            <Button Content="Сформировать документ по выбранной сделке"
                                    DockPanel.Dock="Top"
                                    Height="36"
                                    Margin="0,0,0,10"
                                    Click="PrintDealContract_Click"/>

                            <DataGrid x:Name="DealsGrid"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        CanUserAddRows="False"
                                        RowHeight="35"
                                        ColumnHeaderHeight="38"
                                        HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding DealDate, StringFormat=dd.MM.yyyy}"
                                        Width="110"/>

                                    <DataGridTextColumn Header="Продавец / собственник"
                                        Binding="{Binding SellerName}"
                                        Width="190"/>

                                    <DataGridTextColumn Header="Покупатель / арендатор"
                                        Binding="{Binding ClientName}"
                                        Width="190"/>

                                    <DataGridTextColumn Header="Недвижимость"
                                        Binding="{Binding PropertyAddress}"
                                        Width="*"
                                        MinWidth="170"/>

                                    <DataGridTextColumn Header="Сумма, руб."
                                        Binding="{Binding Amount, StringFormat={}{0:N0}}"
                                        Width="140"/>

                                    <DataGridTextColumn Header="Комиссия, руб."
                                        Binding="{Binding Commission, StringFormat={}{0:N0}}"
                                        Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика">
                <Grid Margin="15">
                    <TabControl>

                        <!-- СРАВНЕНИЕ ПЕРИОДОВ -->
                        <TabItem Header="Сопоставление периодов">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Сопоставление доходов агентства"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Период 1: с"
                                       VerticalAlignment="Center"/>
                                        <DatePicker x:Name="ReportStart1"
                                        Width="145"
                                        Margin="8,0"/>
                                        <TextBlock Text="по"
                                       VerticalAlignment="Center"/>
                                        <DatePicker x:Name="ReportEnd1"
                                        Width="145"
                                        Margin="8,0"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,0,0,12">
                                        <TextBlock Text="Период 2: с"
                                       VerticalAlignment="Center"/>
                                        <DatePicker x:Name="ReportStart2"
                                        Width="145"
                                        Margin="8,0"/>
                                        <TextBlock Text="по"
                                       VerticalAlignment="Center"/>
                                        <DatePicker x:Name="ReportEnd2"
                                        Width="145"
                                        Margin="8,0"/>

                                        <Button Content="Сопоставить"
                                    Width="160"
                                    Click="CalculateProfit_Click"/>
                                    </WrapPanel>
                                </StackPanel>

                                <DataGrid x:Name="ProfitComparisonGrid"
                              Grid.Row="1"
                              Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Показатель"
                                Binding="{Binding Indicator}"
                                Width="2*"/>
                                        <DataGridTextColumn Header="Период 1"
                                Binding="{Binding Period1}"
                                Width="*"/>
                                        <DataGridTextColumn Header="Период 2"
                                Binding="{Binding Period2}"
                                Width="*"/>
                                        <DataGridTextColumn Header="Разница"
                                Binding="{Binding Difference}"
                                Width="*"/>
                                        <DataGridTextColumn Header="Изм. (%)"
                                Binding="{Binding Percent}"
                                Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- ОБЩИЙ ОТЧЁТ -->
                        <TabItem Header="Общий отчёт">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <WrapPanel Margin="0,0,0,15">
                                    <TextBlock Text="Период: с"
                                   VerticalAlignment="Center"/>
                                    <DatePicker x:Name="GeneralReportStart"
                                    Width="145"
                                    Margin="8,0"/>
                                    <TextBlock Text="по"
                                   VerticalAlignment="Center"/>
                                    <DatePicker x:Name="GeneralReportEnd"
                                    Width="145"
                                    Margin="8,0"/>
                                    <Button Content="Сформировать отчёт"
                                Click="GenerateGeneralReport_Click"/>
                                </WrapPanel>

                                <DataGrid x:Name="GeneralReportGrid"
                              Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Показатель"
                                Binding="{Binding Indicator}"
                                Width="2*"/>
                                        <DataGridTextColumn Header="Значение"
                                Binding="{Binding Value}"
                                Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- ПОПУЛЯРНОСТЬ -->
                        <TabItem Header="Популярность недвижимости">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Популярные категории недвижимости"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>
                                    <Button Content="Показать популярные категории"
                                HorizontalAlignment="Left"
                                Click="ShowPopularCategories_Click"/>
                                </StackPanel>

                                <DataGrid x:Name="PopularCategoriesGrid"
                              Grid.Row="1"
                              Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Операция"
                                Binding="{Binding Operation}"
                                Width="*"/>
                                        <DataGridTextColumn Header="Показатель"
                                Binding="{Binding Type}"
                                Width="*"/>
                                        <DataGridTextColumn Header="Популярная категория"
                                Binding="{Binding Category}"
                                Width="2*"/>
                                        <DataGridTextColumn Header="Количество"
                                Binding="{Binding Count}"
                                Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
