<Window x:Class="coursework.EditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование клиента"
        Width="760"
        Height="790"
        MinWidth="650"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <Style TargetType="TextBlock"
               x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="#243247"
                Padding="22,18">
            <StackPanel>
                <TextBlock Text="КАРТОЧКА КЛИЕНТА"
                           Foreground="#B9CBE4"
                           FontSize="12"/>

                <TextBlock Text="Редактирование данных"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,5,0,5"/>

                <TextBlock x:Name="ClientNameTextBlock"
                           Foreground="#DCE7F5"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,18">

            <StackPanel>

                <!-- Личные данные -->
                <GroupBox Header="Личные данные">
                    <StackPanel>

                        <TextBlock Text="Тип лица"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="ClientKindComboBox"
                                  SelectionChanged="ClientKindComboBox_SelectionChanged">
                            <ComboBoxItem Content="Физическое лицо"/>
                            <ComboBoxItem Content="Юридическое лицо"/>
                        </ComboBox>

                        <StackPanel x:Name="OrganizationPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="Наименование организации *"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OrganizationNameTextBox"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Фамилия *"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LastNameTextBox"/>

                                <TextBlock Text="Отчество"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MiddleNameTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Имя *"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FirstNameTextBox"/>

                                <TextBlock Text="Роль клиента"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ClientTypeComboBox">
                                    <ComboBoxItem Content="Покупатель / арендатор"/>
                                    <ComboBoxItem Content="Продавец / арендодатель"/>
                                    <ComboBoxItem Content="Покупатель и продавец"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Контактные данные -->
                <GroupBox Header="Контактная информация">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Контактный телефон *"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PhoneTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Электронная почта"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EmailTextBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Адрес *"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AddressTextBox"/>
                    </StackPanel>
                </GroupBox>

                <!-- Регистрационные данные -->
                <GroupBox Header="Регистрационные сведения">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Регистрационный номер *"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegistrationTextBox"/>

                                <TextBlock Text="Регистрационный взнос, руб."
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegistrationFeeTextBox"></TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Дата регистрации"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegistrationDateTextBox"
                                         IsReadOnly="True"
                                         Background="#EDF2F7"
                                         Foreground="#64748B"/>

                                <TextBlock Text="Дата оплаты взноса"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PaymentDateTextBox"
                                         IsReadOnly="True"
                                         Background="#EDF2F7"
                                         Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="RegistrationFeePaidCheckBox"
                                  Content="Регистрационный взнос оплачен"
                                  Margin="0,5,0,8"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="* Обязательные поля"
                           Foreground="#64748B"
                           FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE3ED"
                BorderThickness="0,1,0,0"
                Padding="20,14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Отмена"
                        Width="125"
                        Height="40"
                        Margin="0,0,12,0"
                        Background="#E2E8F0"
                        Click="Cancel_Click"/>

                <Button Content="Сохранить изменения"
                        Width="190"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
