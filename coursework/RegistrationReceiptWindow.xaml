<Window x:Class="coursework.RegistrationReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Квитанция об оплате"
        Height="510" Width="570"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Печать"
                    Width="110"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="Print_Click"/>

            <Button Content="Закрыть"
                    Width="110"
                    Height="32"
                    Click="Close_Click"/>
        </StackPanel>

        <Border BorderBrush="Gray"
                BorderThickness="1"
                Padding="20">

            <StackPanel x:Name="ReceiptContent">

                <TextBlock Text="ПРИХОДНЫЙ КАССОВЫЙ ОРДЕР"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="NumberText"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="DateText"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="ClientText"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="AddressText"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Основание: регистрационный взнос"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="AmountText"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Separator Margin="0,0,0,20"/>

                <TextBlock Text="Подпись кассира: __________________"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Подпись плательщика: ______________"
                           FontSize="14"/>

            </StackPanel>
        </Border>
    </DockPanel>
</Window>
